#!/usr/bin/env python3
"""pansee — The Agent's Hand on the Pan UI.

Allows an LLM, subagent, or developer to drive the Pan UI live from the command line,
analogous to cosee in Copia.

Usage:
  pansee cast sparql "<query>"       Cast a SPARQL search to the UI (e.g. '?s pan:rating 5')
  pansee cast set <set-id>           Cast a Photoset to the UI (e.g. 's_dance_portfolio_2026')
  pansee cast image <id>             Select and inspect an image (e.g. 'img_01' or 'IMG_0142.CR3')
  pansee cast view grid|graph        Switch view mode between Grid and RDF Graph
  pansee cast instance <id>          Switch active Pan instance (e.g. 'primary-archive', 'studio-2026')
  pansee cast banner "<message>"     Display an agent message banner on the human's screen
  pansee status                      Check if Pan UI server is running and reachable
"""

import json
import os
import sys
import urllib.error
import urllib.request

PORT = int(os.environ.get("PAN_UI_PORT", 7401))
BASE_URL = os.environ.get("PAN_UI_URL", f"http://127.0.0.1:{PORT}")
AGENT_NAME = os.environ.get("PAN_AGENT_NAME", "kira")

def post_cast(payload: dict) -> bool:
    payload["agent"] = AGENT_NAME
    url = f"{BASE_URL}/api/cast"
    req = urllib.request.Request(
        url,
        data=json.dumps(payload).encode("utf-8"),
        headers={"Content-Type": "application/json"}
    )
    try:
        with urllib.request.urlopen(req, timeout=3.0) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            clients = data.get("delivered_to", 0)
            print(f"✓ Cast delivered to {clients} connected browser client(s).")
            return True
    except urllib.error.URLError as e:
        print(f"✕ Failed to connect to Pan UI server at {BASE_URL}: {e}")
        print("  Make sure the server is running: python3 server.py")
        return False

def print_help():
    print(__doc__.strip())

def main():
    if len(sys.argv) < 2:
        print_help()
        sys.exit(1)

    cmd = sys.argv[1].lower()

    if cmd == "status":
        try:
            req = urllib.request.Request(f"{BASE_URL}/index.html")
            with urllib.request.urlopen(req, timeout=2.0):
                print(f"✓ Pan UI server is ONLINE at {BASE_URL}")
        except Exception as e:
            print(f"✕ Pan UI server is OFFLINE at {BASE_URL} ({e})")
        return

    if cmd == "cast":
        if len(sys.argv) < 4 and sys.argv[2] != "banner":
            if len(sys.argv) == 3 and sys.argv[2] == "help":
                print_help()
                return
            print("Error: 'cast' requires a sub-command and argument.")
            print_help()
            sys.exit(1)

        sub = sys.argv[2].lower()
        val = " ".join(sys.argv[3:])

        if sub == "sparql":
            print(f"⚡ Casting SPARQL query: {val}")
            post_cast({"type": "cast_sparql", "query": val})
        elif sub == "set":
            print(f"⚡ Casting Photoset: {val}")
            post_cast({"type": "cast_set", "setId": val})
        elif sub == "image":
            print(f"⚡ Casting Image selection: {val}")
            post_cast({"type": "cast_image", "imageId": val})
        elif sub == "view":
            if val not in ("grid", "graph"):
                print("Error: view must be 'grid' or 'graph'")
                sys.exit(1)
            print(f"⚡ Switching View: {val}")
            post_cast({"type": "cast_view", "view": val})
        elif sub == "instance":
            print(f"⚡ Switching Pan Instance: {val}")
            post_cast({"type": "cast_instance", "instanceId": val})
        elif sub == "banner":
            print(f"⚡ Casting Agent Banner: {val}")
            post_cast({"type": "cast_sparql", "query": val})
        else:
            print(f"Unknown cast type: {sub}")
            print_help()
            sys.exit(1)
    else:
        print(f"Unknown command: {cmd}")
        print_help()
        sys.exit(1)

if __name__ == "__main__":
    main()
